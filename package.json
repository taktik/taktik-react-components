{
  "name": "@taktik/taktik-react-components",
  "private": false,
  "version": "0.0.33",
  "description": "Taktik shared React components (MUI-based DataGrid, theme, utils)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taktik/taktik-react-components.git"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.taktik.be/repository/npm/"
  },
  "sideEffects": [
    "dist/style.css"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx}'",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "verify:consumer": "node scripts/verify-consumer.mjs"
  },
  "keywords": [
    "react",
    "components",
    "typescript",
    "library",
    "taktik"
  ],
  "peerDependencies": {
    "@mui/icons-material": ">=9 <10",
    "@mui/material": ">=9 <10",
    "react": "^19.2",
    "react-dom": "^19.2",
    "styled-components": ">=6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "4.7.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "15.2.10",
    "prettier": "^3.3.3",
    "react": "19.2.7",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.2.7",
    "react-spinners": "^0.14.1",
    "styled-components": "6.4.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.64.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "4.1.9"
  }
}
